{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brainregion.dev/schemas/agent-core/v1/control-message.schema.json",
  "title": "BrainRegion Agent Core Control Message v1",
  "description": "Method-specific JSON-RPC 2.0 messages exchanged with the local brainregiond JSONL control transport.",
  "oneOf": [
    { "$ref": "#/$defs/daemonInfoRequest" },
    { "$ref": "#/$defs/daemonHealthRequest" },
    { "$ref": "#/$defs/daemonShutdownRequest" },
    { "$ref": "#/$defs/mcpToolsListRequest" },
    { "$ref": "#/$defs/mcpToolsCallRequest" },
    { "$ref": "#/$defs/scenePeersListRequest" },
    { "$ref": "#/$defs/scenePeerCallRequest" },
    { "$ref": "#/$defs/daemonInfoResponse" },
    { "$ref": "#/$defs/daemonHealthResponse" },
    { "$ref": "#/$defs/daemonShutdownResponse" },
    { "$ref": "#/$defs/mcpToolsListResponse" },
    { "$ref": "#/$defs/mcpToolsCallResponse" },
    { "$ref": "#/$defs/scenePeersListResponse" },
    { "$ref": "#/$defs/scenePeerCallResponse" },
    { "$ref": "#/$defs/errorResponse" },
    { "$ref": "#/$defs/readyNotification" }
  ],
  "$defs": {
    "id": {
      "description": "JSON-RPC request identifier. Fractional numbers are not accepted.",
      "type": ["string", "integer", "null"]
    },
    "emptyParams": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    "daemonInfoRequest": {
      "title": "daemon/info request",
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "daemon/info" },
        "params": { "$ref": "#/$defs/emptyParams" }
      },
      "additionalProperties": false
    },
    "daemonHealthRequest": {
      "title": "daemon/health request",
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "daemon/health" },
        "params": { "$ref": "#/$defs/emptyParams" }
      },
      "additionalProperties": false
    },
    "daemonShutdownRequest": {
      "title": "daemon/shutdown request",
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "daemon/shutdown" },
        "params": { "$ref": "#/$defs/emptyParams" }
      },
      "additionalProperties": false
    },
    "mcpToolsListRequest": {
      "title": "mcp/tools/list request",
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "mcp/tools/list" },
        "params": { "$ref": "#/$defs/emptyParams" }
      },
      "additionalProperties": false
    },
    "mcpToolsCallRequest": {
      "title": "mcp/tools/call request",
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "mcp/tools/call" },
        "params": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "arguments": { "type": ["object", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scenePeersListRequest": {
      "title": "scene/peers/list request",
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "scene/peers/list" },
        "params": { "$ref": "#/$defs/emptyParams" }
      },
      "additionalProperties": false
    },
    "scenePeerCallRequest": {
      "title": "scene/peer/call request",
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "scene/peer/call" },
        "params": {
          "type": "object",
          "required": ["principalId", "method", "params"],
          "properties": {
            "principalId": { "$ref": "#/$defs/sceneIdentifier" },
            "method": { "$ref": "#/$defs/sceneMethod" },
            "params": { "type": "object" },
            "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "daemonInfoResponse": {
      "title": "daemon/info success response",
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": { "$ref": "#/$defs/daemonInfoResult" }
      },
      "additionalProperties": false
    },
    "daemonHealthResponse": {
      "title": "daemon/health success response",
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": { "$ref": "#/$defs/daemonHealthResult" }
      },
      "additionalProperties": false
    },
    "daemonShutdownResponse": {
      "title": "daemon/shutdown success response",
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "required": ["accepted"],
          "properties": {
            "accepted": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mcpToolsListResponse": {
      "title": "mcp/tools/list success response",
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "required": ["tools"],
          "properties": {
            "tools": {
              "type": "array",
              "items": { "$ref": "#/$defs/mcpTool" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mcpToolsCallResponse": {
      "title": "mcp/tools/call success response",
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": { "$ref": "#/$defs/mcpCallToolResult" }
      },
      "additionalProperties": false
    },
    "scenePeersListResponse": {
      "title": "scene/peers/list success response",
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "required": ["peers"],
          "properties": {
            "peers": {
              "type": "array",
              "items": { "$ref": "#/$defs/scenePeerSnapshot" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scenePeerCallResponse": {
      "title": "scene/peer/call success response",
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "required": ["principalId", "method", "result"],
          "properties": {
            "principalId": { "$ref": "#/$defs/sceneIdentifier" },
            "method": { "$ref": "#/$defs/sceneMethod" },
            "result": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "title": "JSON-RPC error response",
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "data": true
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "readyNotification": {
      "title": "daemon/ready notification",
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "daemon/ready" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "daemon", "status", "mcp"],
          "properties": {
            "protocolVersion": { "const": "brainregion.control.v1" },
            "daemon": { "$ref": "#/$defs/daemonIdentity" },
            "status": { "const": "ready" },
            "mcp": { "$ref": "#/$defs/mcpMetadata" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "daemonInfoResult": {
      "type": "object",
      "required": ["protocolVersion", "daemon", "status", "mcp"],
      "properties": {
        "protocolVersion": { "const": "brainregion.control.v1" },
        "daemon": {
          "type": "object",
          "required": ["name", "version", "uptimeMs", "requestCount"],
          "properties": {
            "name": { "const": "brainregiond" },
            "version": { "type": "string", "minLength": 1 },
            "uptimeMs": { "type": "integer", "minimum": 0 },
            "requestCount": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "status": { "$ref": "#/$defs/status" },
        "mcp": { "$ref": "#/$defs/mcpMetadata" }
      },
      "additionalProperties": false
    },
    "daemonHealthResult": {
      "type": "object",
      "required": ["ok", "status", "daemon", "mcp"],
      "properties": {
        "ok": { "const": true },
        "status": { "$ref": "#/$defs/status" },
        "daemon": {
          "type": "object",
          "required": ["name", "version", "uptimeMs"],
          "properties": {
            "name": { "const": "brainregiond" },
            "version": { "type": "string", "minLength": 1 },
            "uptimeMs": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "mcp": {
          "type": "object",
          "required": ["protocolVersion", "serverInfo", "toolCount", "brainregion"],
          "properties": {
            "protocolVersion": { "type": "string", "minLength": 1 },
            "serverInfo": { "type": "object" },
            "toolCount": { "type": "integer", "minimum": 0 },
            "brainregion": { "$ref": "#/$defs/brainregionPing" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "daemonIdentity": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "brainregiond" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": ["starting", "ready", "degraded", "stopped"]
    },
    "sceneIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "sceneMethod": {
      "enum": [
        "runtime/info",
        "scene/hierarchy",
        "object/inspect",
        "prefab/list",
        "scene/preview",
        "scene/apply",
        "history/undo",
        "logs/poll"
      ]
    },
    "sceneCapability": {
      "enum": ["scene.read", "scene.write", "scene.spawn", "scene.undo", "logs.read"]
    },
    "scenePeerSnapshot": {
      "type": "object",
      "required": [
        "principalId",
        "connectionEpoch",
        "instanceId",
        "sessionId",
        "buildId",
        "sceneId",
        "sceneRevision",
        "runtimeStatus",
        "runtimeError",
        "supportedCapabilities",
        "grantedCapabilities",
        "connectionState"
      ],
      "properties": {
        "principalId": { "$ref": "#/$defs/sceneIdentifier" },
        "connectionEpoch": { "type": "integer", "minimum": 1 },
        "instanceId": { "$ref": "#/$defs/sceneIdentifier" },
        "sessionId": { "$ref": "#/$defs/sceneIdentifier" },
        "buildId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sceneId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sceneRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "runtimeStatus": { "enum": ["ready", "degraded"] },
        "runtimeError": { "type": ["string", "null"], "maxLength": 4096 },
        "supportedCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sceneCapability" }
        },
        "grantedCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sceneCapability" }
        },
        "connectionState": { "const": "connected" }
      },
      "additionalProperties": false
    },
    "mcpMetadata": {
      "type": "object",
      "required": ["protocolVersion", "serverInfo", "capabilities", "toolCount", "brainregion"],
      "properties": {
        "protocolVersion": { "type": "string", "minLength": 1 },
        "serverInfo": { "type": "object" },
        "capabilities": { "type": "object" },
        "toolCount": { "type": "integer", "minimum": 0 },
        "brainregion": { "$ref": "#/$defs/brainregionPing" }
      },
      "additionalProperties": false
    },
    "brainregionPing": {
      "type": "object",
      "required": ["ok", "name", "legacy_name", "version"],
      "properties": {
        "ok": { "const": true },
        "name": { "const": "brainregion" },
        "legacy_name": { "type": ["string", "null"] },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "mcpTool": {
      "description": "MCP Tool forwarded from the Python worker. Known envelope fields are closed; nested MCP schemas and metadata remain extensible.",
      "type": "object",
      "required": ["name", "inputSchema"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "annotations": { "type": "object" },
        "execution": { "type": "object" },
        "icons": {
          "type": "array",
          "items": { "type": "object" }
        },
        "_meta": { "type": "object" }
      },
      "additionalProperties": false
    },
    "mcpCallToolResult": {
      "description": "MCP CallToolResult forwarded from the Python worker.",
      "type": "object",
      "required": ["content"],
      "properties": {
        "resultType": { "const": "complete" },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["text", "image", "audio", "resource", "resource_link"]
              }
            },
            "additionalProperties": true
          }
        },
        "structuredContent": true,
        "isError": { "type": "boolean" },
        "_meta": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
