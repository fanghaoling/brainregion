{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brainregion.dev/schemas/scene-rpc/v1/scene-message.schema.json",
  "title": "BrainRegion Runtime Scene RPC v1",
  "description": "JSON-RPC messages exchanged between a packaged Unity Player and brainregiond.",
  "oneOf": [
    { "$ref": "#/$defs/runtimeChallenge" },
    { "$ref": "#/$defs/runtimeRegister" },
    { "$ref": "#/$defs/runtimeInfoRequest" },
    { "$ref": "#/$defs/hierarchyRequest" },
    { "$ref": "#/$defs/inspectRequest" },
    { "$ref": "#/$defs/prefabListRequest" },
    { "$ref": "#/$defs/previewRequest" },
    { "$ref": "#/$defs/applyRequest" },
    { "$ref": "#/$defs/undoRequest" },
    { "$ref": "#/$defs/persistenceListRequest" },
    { "$ref": "#/$defs/persistenceSaveRequest" },
    { "$ref": "#/$defs/persistenceLoadPreviewRequest" },
    { "$ref": "#/$defs/persistenceLoadRequest" },
    { "$ref": "#/$defs/logsRequest" },
    { "$ref": "#/$defs/successResponse" },
    { "$ref": "#/$defs/errorResponse" },
    { "$ref": "#/$defs/sceneChanged" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,160}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deadline": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "worldSlot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "worldDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "vec3": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "required": ["x", "y", "z"],
      "additionalProperties": false
    },
    "transformPatch": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "rotationEuler": { "$ref": "#/$defs/vec3" },
        "scale": { "$ref": "#/$defs/vec3" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "propertyValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "number" },
        { "type": "string", "maxLength": 16384 },
        { "$ref": "#/$defs/vec3" },
        {
          "type": "object",
          "properties": {
            "objectRef": { "$ref": "#/$defs/objectId" }
          },
          "required": ["objectRef"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "assetRef": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "required": ["assetRef"],
          "additionalProperties": false
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "anyOf": [
              { "type": "null" },
              { "type": "boolean" },
              { "type": "integer" },
              { "type": "number" },
              { "type": "string", "maxLength": 4096 },
              { "$ref": "#/$defs/vec3" }
            ]
          }
        }
      ]
    },
    "propertyChange": {
      "type": "object",
      "properties": {
        "propertyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
        "value": { "$ref": "#/$defs/propertyValue" }
      },
      "required": ["propertyId", "value"],
      "additionalProperties": false
    },
    "spawnOperation": {
      "type": "object",
      "properties": {
        "kind": { "const": "spawn" },
        "tempId": { "type": "string", "pattern": "^tmp:[A-Za-z0-9._-]{1,120}$" },
        "prefabId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$" },
        "parentId": { "$ref": "#/$defs/objectId" },
        "localTransform": { "$ref": "#/$defs/transformPatch" }
      },
      "required": ["kind", "tempId", "prefabId"],
      "additionalProperties": false
    },
    "setTransformOperation": {
      "type": "object",
      "properties": {
        "kind": { "const": "set_transform" },
        "objectId": { "$ref": "#/$defs/objectId" },
        "localTransform": { "$ref": "#/$defs/transformPatch" }
      },
      "required": ["kind", "objectId", "localTransform"],
      "additionalProperties": false
    },
    "setActiveOperation": {
      "type": "object",
      "properties": {
        "kind": { "const": "set_active" },
        "objectId": { "$ref": "#/$defs/objectId" },
        "active": { "type": "boolean" }
      },
      "required": ["kind", "objectId", "active"],
      "additionalProperties": false
    },
    "setPropertiesOperation": {
      "type": "object",
      "properties": {
        "kind": { "const": "set_properties" },
        "objectId": { "$ref": "#/$defs/objectId" },
        "componentId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._:/-]+$" },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/propertyChange" }
        }
      },
      "required": ["kind", "objectId", "componentId", "changes"],
      "additionalProperties": false
    },
    "operation": {
      "oneOf": [
        { "$ref": "#/$defs/spawnOperation" },
        { "$ref": "#/$defs/setTransformOperation" },
        { "$ref": "#/$defs/setActiveOperation" },
        { "$ref": "#/$defs/setPropertiesOperation" }
      ]
    },
    "runtimeChallenge": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "runtime/challenge" },
        "params": {
          "type": "object",
          "properties": {
            "protocolVersion": { "const": "brainregion.scene.pairing.v1" },
            "algorithm": { "const": "hmac-sha256" },
            "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
            "expiresUnixMs": { "$ref": "#/$defs/deadline" },
            "principalId": { "$ref": "#/$defs/id" },
            "grantedCapabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["scene.read", "scene.write", "scene.spawn", "scene.undo", "persistence.read", "persistence.write", "logs.read"]
              }
            }
          },
          "required": ["protocolVersion", "algorithm", "nonce", "expiresUnixMs", "principalId", "grantedCapabilities"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false
    },
    "runtimeRegister": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "runtime/register" },
        "params": {
          "type": "object",
          "properties": {
            "protocolVersion": { "const": "brainregion.scene.v1" },
            "instanceId": { "$ref": "#/$defs/id" },
            "sessionId": { "$ref": "#/$defs/id" },
            "buildId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "unityVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
            "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
            "product": { "type": "string", "minLength": 1, "maxLength": 256 },
            "sceneId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "sceneRevision": { "$ref": "#/$defs/revision" },
            "status": { "enum": ["ready", "degraded"] },
            "error": { "type": ["string", "null"], "maxLength": 4096 },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["scene.read", "scene.write", "scene.spawn", "scene.undo", "persistence.read", "persistence.write", "logs.read"]
              }
            },
            "pairingProof": { "type": ["string", "null"], "pattern": "^hmac-sha256\\.[A-Za-z0-9_-]{43}$" }
          },
          "required": ["protocolVersion", "instanceId", "sessionId", "buildId", "unityVersion", "platform", "product", "sceneId", "sceneRevision", "status", "error", "capabilities"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false
    },
    "runtimeInfoRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "runtime/info" },
        "deadlineUnixMs": { "$ref": "#/$defs/deadline" },
        "params": { "type": "object", "maxProperties": 0 }
      },
      "required": ["jsonrpc", "id", "method", "deadlineUnixMs", "params"],
      "additionalProperties": false
    },
    "hierarchyRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "scene/hierarchy" },
        "deadlineUnixMs": { "$ref": "#/$defs/deadline" },
        "params": {
          "type": "object",
          "properties": {
            "rootId": { "$ref": "#/$defs/objectId" },
            "depth": { "type": "integer", "minimum": 0, "maximum": 8 },
            "includeInactive": { "type": "boolean" },
            "cursor": { "type": ["string", "null"], "maxLength": 256 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
            "ifRevision": { "$ref": "#/$defs/revision" }
          },
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "method", "deadlineUnixMs", "params"],
      "additionalProperties": false
    },
    "inspectRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "object/inspect" },
        "deadlineUnixMs": { "$ref": "#/$defs/deadline" },
        "params": {
          "type": "object",
          "properties": {
            "objectId": { "$ref": "#/$defs/objectId" },
            "componentIds": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 64,
              "items": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._:/-]+$" }
            }
          },
          "required": ["objectId"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "method", "deadlineUnixMs", "params"],
      "additionalProperties": false
    },
    "prefabListRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "prefab/list" },
        "deadlineUnixMs": { "$ref": "#/$defs/deadline" },
        "params": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "maxLength": 256 },
            "cursor": { "type": ["string", "null"], "maxLength": 256 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
          },
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "method", "deadlineUnixMs", "params"],
      "additionalProperties": false
    },
    "previewRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "scene/preview" },
        "deadlineUnixMs": { "$ref": "#/$defs/deadline" },
        "params": {
          "type": "object",
          "properties": {
            "expectedRevision": { "$ref": "#/$defs/revision" },
            "clientMutationId": { "$ref": "#/$defs/id" },
            "commands": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": { "$ref": "#/$defs/operation" }
            }
          },
          "required": ["expectedRevision", "clientMutationId", "commands"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "method", "deadlineUnixMs", "params"],
      "additionalProperties": false
    },
    "applyRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "scene/apply" },
        "deadlineUnixMs": { "$ref": "#/$defs/deadline" },
        "params": {
          "type": "object",
          "properties": {
            "previewToken": { "$ref": "#/$defs/id" },
            "expectedRevision": { "$ref": "#/$defs/revision" },
            "clientMutationId": { "$ref": "#/$defs/id" }
          },
          "required": ["previewToken", "expectedRevision", "clientMutationId"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "method", "deadlineUnixMs", "params"],
      "additionalProperties": false
    },
    "undoRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "history/undo" },
        "deadlineUnixMs": { "$ref": "#/$defs/deadline" },
        "params": {
          "type": "object",
          "properties": {
            "expectedRevision": { "$ref": "#/$defs/revision" },
            "undoId": { "$ref": "#/$defs/id" }
          },
          "required": ["expectedRevision"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "method", "deadlineUnixMs", "params"],
      "additionalProperties": false
    },
    "persistenceListRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "persistence/list" },
        "deadlineUnixMs": { "$ref": "#/$defs/deadline" },
        "params": { "type": "object", "maxProperties": 0 }
      },
      "required": ["jsonrpc", "id", "method", "deadlineUnixMs", "params"],
      "additionalProperties": false
    },
    "persistenceSaveRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "persistence/save" },
        "deadlineUnixMs": { "$ref": "#/$defs/deadline" },
        "params": {
          "type": "object",
          "properties": {
            "slot": { "$ref": "#/$defs/worldSlot" },
            "expectedRevision": { "$ref": "#/$defs/revision" },
            "clientMutationId": { "$ref": "#/$defs/id" },
            "expectedSlotDigest": { "$ref": "#/$defs/worldDigest" },
            "metadata": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "maxLength": 256 }
              },
              "additionalProperties": false
            }
          },
          "required": ["slot", "expectedRevision", "clientMutationId"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "method", "deadlineUnixMs", "params"],
      "additionalProperties": false
    },
    "persistenceLoadPreviewRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "persistence/loadPreview" },
        "deadlineUnixMs": { "$ref": "#/$defs/deadline" },
        "params": {
          "type": "object",
          "properties": {
            "slot": { "$ref": "#/$defs/worldSlot" },
            "expectedRevision": { "$ref": "#/$defs/revision" },
            "clientMutationId": { "$ref": "#/$defs/id" }
          },
          "required": ["slot", "expectedRevision", "clientMutationId"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "method", "deadlineUnixMs", "params"],
      "additionalProperties": false
    },
    "persistenceLoadRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "persistence/load" },
        "deadlineUnixMs": { "$ref": "#/$defs/deadline" },
        "params": {
          "type": "object",
          "properties": {
            "previewToken": { "$ref": "#/$defs/id" },
            "expectedRevision": { "$ref": "#/$defs/revision" },
            "clientMutationId": { "$ref": "#/$defs/id" }
          },
          "required": ["previewToken", "expectedRevision", "clientMutationId"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "method", "deadlineUnixMs", "params"],
      "additionalProperties": false
    },
    "logsRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "logs/poll" },
        "deadlineUnixMs": { "$ref": "#/$defs/deadline" },
        "params": {
          "type": "object",
          "properties": {
            "afterSeq": { "type": "integer", "minimum": 0 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
            "levels": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["info", "warning", "error", "exception", "assert"] }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "method", "deadlineUnixMs", "params"],
      "additionalProperties": false
    },
    "propertyDescriptor": {
      "type": "object",
      "properties": {
        "propertyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
        "displayName": { "type": ["string", "null"], "maxLength": 256 },
        "valueType": { "type": ["string", "null"], "maxLength": 128 },
        "readOnly": { "type": "boolean" },
        "persistent": { "type": "boolean" },
        "minimum": { "type": ["number", "null"] },
        "maximum": { "type": ["number", "null"] },
        "enumValues": {
          "type": ["array", "null"],
          "maxItems": 256,
          "items": { "type": "string", "maxLength": 256 }
        }
      },
      "required": ["propertyId", "displayName", "valueType", "readOnly", "persistent", "minimum", "maximum", "enumValues"],
      "additionalProperties": false
    },
    "propertySnapshot": {
      "type": "object",
      "properties": {
        "descriptor": { "$ref": "#/$defs/propertyDescriptor" },
        "value": { "$ref": "#/$defs/propertyValue" }
      },
      "required": ["descriptor", "value"],
      "additionalProperties": false
    },
    "componentSnapshot": {
      "type": "object",
      "properties": {
        "componentId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._:/-]+$" },
        "typeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$" },
        "properties": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/propertySnapshot" }
        }
      },
      "required": ["componentId", "typeId", "properties"],
      "additionalProperties": false
    },
    "objectSnapshot": {
      "type": "object",
      "properties": {
        "objectId": { "$ref": "#/$defs/objectId" },
        "parentId": { "oneOf": [{ "$ref": "#/$defs/objectId" }, { "type": "null" }] },
        "name": { "type": "string", "maxLength": 1024 },
        "active": { "type": "boolean" },
        "layer": { "type": "integer", "minimum": 0, "maximum": 31 },
        "tag": { "type": "string", "maxLength": 256 },
        "prefabId": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }] },
        "childCount": { "type": "integer", "minimum": 0 },
        "components": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/componentSnapshot" }
        }
      },
      "required": ["objectId", "parentId", "name", "active", "layer", "tag", "prefabId", "childCount", "components"],
      "additionalProperties": false
    },
    "runtimeInfoResult": {
      "type": "object",
      "properties": {
        "protocolVersion": { "const": "brainregion.scene.v1" },
        "instanceId": { "$ref": "#/$defs/id" },
        "sessionId": { "$ref": "#/$defs/id" },
        "buildId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "unityVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
        "product": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sceneId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sceneRevision": { "$ref": "#/$defs/revision" },
        "status": { "enum": ["ready", "degraded"] },
        "error": { "type": ["string", "null"], "maxLength": 4096 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["scene.read", "scene.write", "scene.spawn", "scene.undo", "persistence.read", "persistence.write", "logs.read"] }
        }
      },
      "required": ["protocolVersion", "instanceId", "sessionId", "buildId", "unityVersion", "platform", "product", "sceneId", "sceneRevision", "status", "error", "capabilities"],
      "additionalProperties": false
    },
    "hierarchyResult": {
      "type": "object",
      "properties": {
        "sceneRevision": { "$ref": "#/$defs/revision" },
        "nodes": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/objectSnapshot" } },
        "nextCursor": { "type": ["string", "null"], "maxLength": 256 },
        "notModified": { "type": "boolean" }
      },
      "required": ["sceneRevision", "nodes", "nextCursor", "notModified"],
      "additionalProperties": false
    },
    "inspectResult": {
      "type": "object",
      "properties": {
        "sceneRevision": { "$ref": "#/$defs/revision" },
        "observedFrame": { "type": "integer", "minimum": 0 },
        "object": { "$ref": "#/$defs/objectSnapshot" }
      },
      "required": ["sceneRevision", "observedFrame", "object"],
      "additionalProperties": false
    },
    "prefabListResult": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "entries": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "prefabId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "displayName": { "type": "string", "maxLength": 256 },
              "tags": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 128 } }
            },
            "required": ["prefabId", "displayName", "tags"],
            "additionalProperties": false
          }
        },
        "nextCursor": { "type": ["string", "null"], "maxLength": 256 }
      },
      "required": ["schemaVersion", "entries", "nextCursor"],
      "additionalProperties": false
    },
    "previewResult": {
      "type": "object",
      "properties": {
        "previewToken": { "$ref": "#/$defs/id" },
        "baseRevision": { "$ref": "#/$defs/revision" },
        "expiresAtUnixMs": { "$ref": "#/$defs/deadline" },
        "clientMutationId": { "$ref": "#/$defs/id" },
        "summary": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 4096 } },
        "warnings": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 4096 } }
      },
      "required": ["previewToken", "baseRevision", "expiresAtUnixMs", "clientMutationId", "summary", "warnings"],
      "additionalProperties": false
    },
    "mutationResult": {
      "type": "object",
      "properties": {
        "sceneRevision": { "$ref": "#/$defs/revision" },
        "clientMutationId": { "$ref": "#/$defs/id" },
        "undoId": { "$ref": "#/$defs/id" },
        "tempIdMap": {
          "type": "object",
          "propertyNames": { "pattern": "^tmp:[A-Za-z0-9._-]{1,120}$" },
          "additionalProperties": { "$ref": "#/$defs/objectId" }
        },
        "idempotentReplay": { "type": "boolean" }
      },
      "required": ["sceneRevision", "clientMutationId", "undoId", "tempIdMap", "idempotentReplay"],
      "additionalProperties": false
    },
    "undoResult": {
      "type": "object",
      "properties": {
        "sceneRevision": { "$ref": "#/$defs/revision" },
        "undoId": { "$ref": "#/$defs/id" },
        "undoneClientMutationId": { "$ref": "#/$defs/id" }
      },
      "required": ["sceneRevision", "undoId", "undoneClientMutationId"],
      "additionalProperties": false
    },
    "persistenceListResult": {
      "type": "object",
      "properties": {
        "slots": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "slot": { "$ref": "#/$defs/worldSlot" },
              "digest": { "$ref": "#/$defs/worldDigest" },
              "savedRevision": { "$ref": "#/$defs/revision" },
              "savedUnixMs": { "$ref": "#/$defs/deadline" },
              "label": { "type": ["string", "null"], "maxLength": 256 },
              "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
            },
            "required": ["slot", "digest", "savedRevision", "savedUnixMs", "label", "bytes"],
            "additionalProperties": false
          }
        },
        "corruptSlots": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "slot": { "type": "string", "minLength": 1, "maxLength": 255 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "required": ["slot", "reason"],
            "additionalProperties": false
          }
        },
        "maximumSlots": { "const": 32 },
        "maximumFileBytes": { "const": 1048576 },
        "maximumStorageBytes": { "const": 16777216 }
      },
      "required": ["slots", "corruptSlots", "maximumSlots", "maximumFileBytes", "maximumStorageBytes"],
      "additionalProperties": false
    },
    "persistenceSaveResult": {
      "type": "object",
      "properties": {
        "slot": { "$ref": "#/$defs/worldSlot" },
        "digest": { "$ref": "#/$defs/worldDigest" },
        "savedRevision": { "$ref": "#/$defs/revision" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "idempotentReplay": { "type": "boolean" }
      },
      "required": ["slot", "digest", "savedRevision", "bytes", "idempotentReplay"],
      "additionalProperties": false
    },
    "persistenceLoadPreviewResult": {
      "type": "object",
      "properties": {
        "previewToken": { "$ref": "#/$defs/id" },
        "slot": { "$ref": "#/$defs/worldSlot" },
        "digest": { "$ref": "#/$defs/worldDigest" },
        "baseRevision": { "$ref": "#/$defs/revision" },
        "clientMutationId": { "$ref": "#/$defs/id" },
        "expiresAtUnixMs": { "$ref": "#/$defs/deadline" },
        "summary": {
          "type": "object",
          "properties": {
            "entities": { "type": "integer", "minimum": 1, "maximum": 256 },
            "create": { "type": "integer", "minimum": 0, "maximum": 256 },
            "reuse": { "type": "integer", "minimum": 0, "maximum": 256 },
            "remove": { "type": "integer", "minimum": 0, "maximum": 256 }
          },
          "required": ["entities", "create", "reuse", "remove"],
          "additionalProperties": false
        }
      },
      "required": ["previewToken", "slot", "digest", "baseRevision", "clientMutationId", "expiresAtUnixMs", "summary"],
      "additionalProperties": false
    },
    "persistenceLoadResult": {
      "type": "object",
      "properties": {
        "slot": { "$ref": "#/$defs/worldSlot" },
        "digest": { "$ref": "#/$defs/worldDigest" },
        "sceneRevision": { "$ref": "#/$defs/revision" },
        "clientMutationId": { "$ref": "#/$defs/id" },
        "idempotentReplay": { "type": "boolean" }
      },
      "required": ["slot", "digest", "sceneRevision", "clientMutationId", "idempotentReplay"],
      "additionalProperties": false
    },
    "logsResult": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "seq": { "type": "integer", "minimum": 1 },
              "timestampUnixMs": { "$ref": "#/$defs/deadline" },
              "level": { "enum": ["info", "warning", "error", "exception", "assert"] },
              "message": { "type": "string", "maxLength": 16384 },
              "stackTrace": { "type": "string", "maxLength": 65536 }
            },
            "required": ["seq", "timestampUnixMs", "level", "message", "stackTrace"],
            "additionalProperties": false
          }
        },
        "nextSeq": { "type": "integer", "minimum": 0 },
        "droppedBefore": { "type": "integer", "minimum": 0 }
      },
      "required": ["entries", "nextSeq", "droppedBefore"],
      "additionalProperties": false
    },
    "successResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/runtimeInfoResult" },
            { "$ref": "#/$defs/hierarchyResult" },
            { "$ref": "#/$defs/inspectResult" },
            { "$ref": "#/$defs/prefabListResult" },
            { "$ref": "#/$defs/previewResult" },
            { "$ref": "#/$defs/mutationResult" },
            { "$ref": "#/$defs/undoResult" },
            { "$ref": "#/$defs/persistenceListResult" },
            { "$ref": "#/$defs/persistenceSaveResult" },
            { "$ref": "#/$defs/persistenceLoadPreviewResult" },
            { "$ref": "#/$defs/persistenceLoadResult" },
            { "$ref": "#/$defs/logsResult" }
          ]
        }
      },
      "required": ["jsonrpc", "id", "result"],
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "error": {
          "type": "object",
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string", "minLength": 1 },
            "data": {
              "type": "object",
              "properties": {
                "reason": { "type": "string" },
                "objectId": { "$ref": "#/$defs/objectId" },
                "componentId": { "type": "string" },
                "propertyId": { "type": "string" },
                "expectedRevision": { "$ref": "#/$defs/revision" },
                "actualRevision": { "$ref": "#/$defs/revision" },
                "retryable": { "type": "boolean" }
              },
              "additionalProperties": true
            }
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "error"],
      "additionalProperties": false
    },
    "sceneChanged": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "scene/changed" },
        "params": {
          "type": "object",
          "properties": {
            "sceneRevision": { "$ref": "#/$defs/revision" },
            "clientMutationId": { "type": ["string", "null"], "maxLength": 128 },
            "summary": { "type": "string", "maxLength": 4096 }
          },
          "required": ["sceneRevision", "summary"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false
    }
  }
}
